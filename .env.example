# ═══ أساسيات ═══
PORT=3000
SITE_URL=https://al-ltc.com
JWT_SECRET=غيّر_هذا_بسلسلة_عشوائية_طويلة
DB_PATH=./alsaeed.db

# ═══ حساب المشرف الأول (يُنشأ مرة واحدة) ═══
ADMIN_EMAIL=info@al-ltc.com
ADMIN_PASSWORD=غيّرها_فوراً

# ═══ بوابة الدفع — المفاتيح السرّية لا تظهر في المتصفح أبداً ═══

# ── Paymob (مصر) — الخيار الموصى به ──
# سجّل في accept.paymob.com ← Settings ← Account Info
PAYMOB_SECRET_KEY=
PAYMOB_PUBLIC_KEY=
# معرّفات طرق الدفع من: Developers ← Payment Integrations
# (كارت أونلاين، ميزة، محفظة موبايل، فوري) — افصل بفاصلة
PAYMOB_INTEGRATION_IDS=

# ── ميسر (السعودية) — اختياري للعملاء الخليجيين ──
MOYASAR_SECRET_KEY=

# ── تاب (الخليج) — اختياري ──
TAP_SECRET_KEY=

# ═══ الأمان ═══
ALLOWED_ORIGIN=https://al-ltc.com

# ═══ لوحة الإدارة المستقلة ═══
# غيّر هذا المسار لشيء يصعب تخمينه — هذا رابط لوحتك السرّي
ADMIN_PANEL_PATH=manage-x7k
